# ==============================================================================
# POLYMARKET 跟单机器人 - 配置说明
# ==============================================================================

# ------------------------------------------------------------------------------
# 要跟单的交易员（支持多个地址）
# ------------------------------------------------------------------------------
# 方式一：单个交易员
# USER_ADDRESSES = '0xd62531bc536bff72394fc5ef715525575787e809'

# 方式二：多个交易员（逗号分隔）
# USER_ADDRESSES = '0xTrader1..., 0xTrader2..., 0xTrader3...'

# 方式三：多个交易员（JSON 数组格式）
# USER_ADDRESSES = '["0xTrader1...", "0xTrader2...", "0xTrader3..."]'

USER_ADDRESSES=''

# ------------------------------------------------------------------------------
# 您的钱包配置
# ------------------------------------------------------------------------------
# 方式 A：单个跟单钱包（经典模式）
# 您的 Polygon 钱包地址（必须与 PRIVATE_KEY 对应）
PROXY_WALLET=''

# 钱包私钥（不要带 0x 前缀）
# ⚠️  切勿分享此密钥或提交到 git！
PRIVATE_KEY='your_private_key_here_without_0x_prefix'

# 方式 B：多个跟单钱包（轮询）
# 每笔新交易由列表中的下一个钱包执行（循环使用）。
# 只能使用 (PROXY_WALLET + PRIVATE_KEY) 或 (PROXY_WALLETS + PRIVATE_KEYS) 其一，不能同时设置。
# PROXY_WALLETS：逗号分隔或 JSON 数组，顺序与 PRIVATE_KEYS 一致
# PROXY_WALLETS = '0xWallet1...,0xWallet2...,0xWallet3...'
# PRIVATE_KEYS：逗号分隔，每个钱包一个密钥（顺序与 PROXY_WALLETS 一致）
# PRIVATE_KEYS = 'key1,key2,key3'
# 若同时设置了方式 A 和 B，则以 PROXY_WALLETS/PRIVATE_KEYS 为准。

# ------------------------------------------------------------------------------
# POLYMARKET API 端点
# ------------------------------------------------------------------------------
CLOB_HTTP_URL='https://clob.polymarket.com/'
CLOB_WS_URL='wss://ws-subscriptions-clob.polymarket.com/ws'

# ------------------------------------------------------------------------------
# 机器人设置
# ------------------------------------------------------------------------------
# 检查新交易的间隔（秒）
FETCH_INTERVAL=1

# 忽略超过 X 小时的交易
TOO_OLD_TIMESTAMP=1

# 订单失败时的最大重试次数
RETRY_LIMIT=3

# 网络请求超时时间（毫秒，默认 10000 = 10 秒）
# 若经常超时可适当增大
REQUEST_TIMEOUT_MS=10000

# 网络错误时的最大重试次数（默认 3）
# 用于应对 Polymarket API 的临时连接问题
NETWORK_RETRY_LIMIT=3

# ==============================================================================
# 跟单策略配置（新系统）
# ==============================================================================
# 选择跟单策略：PERCENTAGE（比例）、FIXED（固定金额）或 ADAPTIVE（自适应）
# - PERCENTAGE：按交易员订单的固定比例跟单（适合新手）
# - FIXED：每笔交易跟单固定美元金额（支出可预期）
# - ADAPTIVE：根据交易规模动态调整比例（进阶）
COPY_STRATEGY='PERCENTAGE'

# 主参数含义因策略而异：
# - PERCENTAGE：跟单比例（如 10.0 表示 10%）
# - FIXED：每笔跟单的固定美元金额（如 50.0 表示 50 美元）
# - ADAPTIVE：自适应缩放的基础比例（如 10.0 表示 10%）
COPY_SIZE=5.0

# ------------------------------------------------------------------------------
# 安全限额（保护账户）
# ------------------------------------------------------------------------------
# 单笔订单最大金额（美元，默认 100.0）
# 防止跟单对象下大单时您也跟出过大订单
MAX_ORDER_SIZE_USD=100.0

# 单笔订单最小金额（美元，默认 1.0）
# 低于此金额的订单将跳过（Polymarket 要求）
MIN_ORDER_SIZE_USD=1.0

# 可选：单个市场最大持仓总金额（美元）
# 防止在单一市场上持仓过大
# MAX_POSITION_SIZE_USD = 500.0

# 可选：每日最大交易量（美元）
# 防止单日过度交易
# MAX_DAILY_VOLUME_USD = 1000.0

# ------------------------------------------------------------------------------
# 自适应策略参数（仅当 COPY_STRATEGY = 'ADAPTIVE' 时生效）
# ------------------------------------------------------------------------------
# 大单时的最小比例（默认 5.0）
ADAPTIVE_MIN_PERCENT=1.0

# 小单时的最大比例（默认 20.0）
ADAPTIVE_MAX_PERCENT=5.0

# 触发自适应的金额阈值（美元，默认 500.0）
# 高于此金额用较低比例，低于此金额用较高比例
ADAPTIVE_THRESHOLD_USD=1000.0

# ==============================================================================
# 分层乘数（新功能）
# ==============================================================================
# 根据交易员持仓规模应用不同乘数
# 解决跟单对象仓位大小不一的问题：
# - 小单用较高乘数（不错过机会）
# - 大单用较低乘数（避免过度跟单）
#
# 格式："最小-最大:乘数,最小-最大:乘数,最小+:乘数"
# - "最小-最大" 表示有上下界的区间
# - "最小+" 表示无上界（必须放在最后）
# - 区间以交易员订单金额（美元）为准
#
# 示例：约 2000 美元账户跟单 50 万–100 万美元的交易员：
# TIERED_MULTIPLIERS = 1-10:2.0,10-100:1.0,100-500:0.2,500-1000:0.1,1000-5000:0.02,5000-10000:0.01,10000-50000:0.002,50000-100000:0.001,100000-500000:0.0005,500000+:0.0002
#
# 效果说明：
# - 交易员 5 美元 × 2.0 = 跟单 10 美元（捕捉小单）
# - 交易员 50 美元 × 1.0 = 跟单 50 美元
# - 交易员 500 美元 × 0.1 = 跟单 50 美元
# - 交易员 10000 美元 × 0.002 = 跟单 20 美元
# - 交易员 250000 美元 × 0.0002 = 跟单 50 美元（控制大单）
#
# 简单示例（约 1000 美元账户）：
# TIERED_MULTIPLIERS = 1-100:2.0,100-1000:0.5,1000-10000:0.1,10000+:0.01
#
# 不设置则使用单一 TRADE_MULTIPLIER 或无乘数（1.0x）

# ==============================================================================
# 旧版配置（向后兼容）
# ==============================================================================
# 保留以兼容旧版 .env 文件
# 若不设置 COPY_STRATEGY，机器人将使用以下项：
# - COPY_PERCENTAGE：跟单比例（默认 10.0）
# - TRADE_MULTIPLIER：应用于跟单比例的单一乘数（默认 1.0）
# ⚠️  已弃用：请迁移到上方新的 COPY_STRATEGY 系统！
# ⚠️  注意：若设置了 TIERED_MULTIPLIERS，将覆盖 TRADE_MULTIPLIER
# COPY_PERCENTAGE = 10.0
# TRADE_MULTIPLIER = 1.0

# ------------------------------------------------------------------------------
# 交易汇总设置（新功能）
# ------------------------------------------------------------------------------
# 是否启用小单汇总（默认 false）
# - true = 将同一交易员的多笔小单合并为一笔较大订单
# - false = 每笔交易单独执行（原有行为）
# 💡 当跟单对象有很多小单、单笔低于 Polymarket 最低 1 美元但合计值得跟单时很有用！
TRADE_AGGREGATION_ENABLED=false

# 执行前等待更多交易的时间窗口（秒）
# 默认：300（5 分钟）
# - 60 = 1 分钟
# - 300 = 5 分钟（推荐）
# - 600 = 10 分钟
# ⏱️  窗口越长可合并更多交易，但执行会延迟
TRADE_AGGREGATION_WINDOW_SECONDS=300

# 预览/模拟模式（默认 false）
# - true = 仅监控交易，不实际下单（安全测试）
# - false = 正常执行交易（实盘）
# 🔍 用预览模式可在不占用资金的情况下测试机器人！
PREVIEW_MODE=true

# ------------------------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------------------------
# MongoDB 连接字符串
# ⚠️  请勿泄露！不要分享或提交到 git！
MONGO_URI='mongodb+srv://username:password@cluster.mongodb.net/database'

# ------------------------------------------------------------------------------
# 区块链配置（Polygon 主网）
# ------------------------------------------------------------------------------
# Polygon RPC 端点（可使用 Infura、Alchemy 或 QuickNode）
RPC_URL='https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY'

# Polygon 上的 USDC 合约地址（请勿修改）
USDC_CONTRACT_ADDRESS='0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174'

# ==============================================================================
# 安全提示：
# - 切勿将 .env 文件提交到 git（已在 .gitignore 中）
# - 为机器人使用资金有限的专用钱包
# - 定期查看机器人活动
# - 若 MongoDB 密码泄露请立即修改
# ==============================================================================
